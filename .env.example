LLM_PROVIDER=vercel_gateway

# Vercel AI Gateway (default)
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=google/gemini-3.5-flash-lite
AI_GATEWAY_FALLBACK_MODELS=

# Direct Google Gemini (optional when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

CLINIC_NAME=Clínica Modelo

# API & Database (Phase 3)
DATABASE_URL=sqlite:///./data/iara.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
API_HOST=127.0.0.1
API_PORT=8000
SESSION_TIMEOUT_MINUTES=20
STAFF_API_KEY=
